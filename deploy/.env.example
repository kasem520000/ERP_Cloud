# ---------------------------------------------------------------------------
# نموذج بيئة النشر — انسخه إلى `deploy/.env` ثم عدّل القيم.
#   cp deploy/.env.example deploy/.env && $EDITOR deploy/.env
#
# ⚠️ `deploy/.env` **لا يُودَع** (`.gitignore`). والقيم السرّية تُولَّد بأمر
#    `pnpm env:setup` الذي يكتب ملف `.env` في الجذر — خُذ منه: JWT_PRIVATE_KEY،
#    JWT_PUBLIC_KEY، JWT_KEY_ID، DATA_ENC_KEY، FILE_URL_SIGNING_SECRET، وكلمات المرور.
# ---------------------------------------------------------------------------

# --- قاعدة البيانات ---------------------------------------------------------
POSTGRES_DB=app
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_APP_PASSWORD=change-me-app-password
DATABASE_MIGRATOR_PASSWORD=change-me-migrator-password

# --- الـAPI والواجهات العامة ------------------------------------------------
# منافذ التشغيل ومن يُسمح له بالاتصال (CORS) — نطاقات sahabaccounting.com.
PORT=3000
CORS_ALLOWED_ORIGINS=https://sahabaccounting.com,https://staff.sahabaccounting.com,https://portal.sahabaccounting.com,https://admin.sahabaccounting.com,https://bakery.sahabaccounting.com
PUBLIC_APP_URL=https://sahabaccounting.com
STAFF_PUBLIC_URL=https://staff.sahabaccounting.com
MARKETING_PUBLIC_URL=https://sahabaccounting.com
CONSOLE_PUBLIC_URL=https://admin.sahabaccounting.com
CUSTOMER_PUBLIC_URL=https://portal.sahabaccounting.com
NEXT_PUBLIC_STAFF_URL=https://staff.sahabaccounting.com
NEXT_PUBLIC_PORTAL_URL=https://portal.sahabaccounting.com
NEXT_PUBLIC_PLATFORM_URL=https://admin.sahabaccounting.com
NEXT_PUBLIC_MARKETING_URL=https://sahabaccounting.com
NEXT_PUBLIC_BAKERY_URL=https://bakery.sahabaccounting.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@sahabaccounting.com

# --- الأسرار (لا تُكتب هنا في مستودعٍ عام) -----------------------------------
JWT_KEY_ID=dev-key-1
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n…\n-----END PUBLIC KEY-----"
DATA_ENC_KEY=
FILE_URL_SIGNING_SECRET=
PLATFORM_ADMIN_EMAIL=admin@platform.test
PLATFORM_ADMIN_PASSWORD=
DEMO_OWNER_EMAIL=owner@demo.test
DEMO_OWNER_PASSWORD=

# --- البريد -----------------------------------------------------------------
# `smtp` مع MailHog في هذا الملف (`mailhog:1025`)، و`console` يسجّل الرسائل بلا إرسال.
MAIL_TRANSPORT=smtp
MAIL_FROM="ERP <no-reply@erp.test>"
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- مزوّد الدفع (اختياري) ---------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- الموقع التسويقي ---------------------------------------------------------
# نافذة صلاحية ذاكرة بيانات Next (ثوانٍ). 30 في الإنتاج (تخزين)، و0 للعرض الفوري
# (وهو ما يفعله `pnpm start:erp:local` المحلي).
MARKETING_REVALIDATE_SECONDS=30

# --- البذرة -----------------------------------------------------------------
# `1` تُبذر بيانات العرض (منشأتان + مستخدمون + دليل حسابات). اجعلها `0` في الإنتاج.
SEED_DEMO=1
DEMO_PLAN_CODE=pro-monthly
