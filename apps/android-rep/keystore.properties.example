# إعدادُ التوقيع المحليّ (لا يُودَع في Git) — انسخه إلى keystore.properties واملأه:
#   storeFile=release.keystore
#   storePassword=كلمةُ ممرِّ المخزن
#   keyAlias=rep
#   keyPassword=كلمةُ ممرِّ المفتاح
#
# في CI يُستعملُ متغيّراتُ البيئة (KEYSTORE_FILE/KEYSTORE_PASSWORD/KEY_ALIAS/KEY_PASSWORD)
# بدل هذا الملف — انظر .github/workflows/build-apk.yml
